<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark: the KaoriOS planet (light-blue sphere, coral ring) with a patcher hex-nut
  fastened onto the ring where it leaves the planet's limb. Built for the adaptive-icon
  108x108 viewport; everything sits inside the 66x66 safe circle.

  The sphere and the ring are gel-shaded: each is one VectorDrawable gradient (radial for the
  sphere, linear along the ring) with a light stop toward the upper left, so the mark reads as a
  lit object rather than three flat fills. The glint, the shade and the specular highlight ride
  on top with alpha baked into their gradients — they are light falling on the sphere, not
  separate shapes. The hex nut is deliberately flat: it is the tool in the scene, not part of the
  planet. ic_launcher_monochrome is a single-colour silhouette and stays out of this.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Contact shadow, so the sphere sits in front of the backdrop instead of on it. -->
    <path android:pathData="M36,76 a20,5.5 0 1,0 40,0 a20,5.5 0 1,0 -40,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="56"
                android:centerY="77"
                android:gradientRadius="22"
                android:startColor="@color/kaori_contact"
                android:endColor="@color/kaori_contact_edge" />
        </aapt:attr>
    </path>

    <!-- The ring's far half — drawn first so the sphere occludes it. -->
    <path
        android:pathData="M25.47,65.27 C21.14,51.96 78.21,33.41 82.53,46.73"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="70"
                android:endX="90"
                android:endY="40"
                android:startColor="@color/kaori_ring_lit"
                android:endColor="@color/kaori_ring_deep" />
        </aapt:attr>
    </path>

    <!-- Sphere: radial from the lit upper left to the shaded limb. -->
    <path android:pathData="M33,56 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="45"
                android:centerY="45"
                android:gradientRadius="44"
                android:startColor="@color/kaori_planet_lit"
                android:centerColor="@color/kaori_planet_mid"
                android:endColor="@color/kaori_planet_deep" />
        </aapt:attr>
    </path>

    <!-- Upper glint. -->
    <path android:pathData="M35.813,45.5 C44,53 64,53 72.187,45.5 A21,21 0 0,0 35.813,45.5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="44"
                android:endX="54"
                android:endY="56"
                android:startColor="@color/kaori_glint_near"
                android:endColor="@color/kaori_glint_far" />
        </aapt:attr>
    </path>

    <!-- Lower shade. -->
    <path android:pathData="M74.2844,50.5648 C66,60 45,66 33.7156,61.4352 A21,21 0 0,0 74.2844,50.5648 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="55"
                android:endX="54"
                android:endY="70"
                android:startColor="@color/kaori_shade_near"
                android:endColor="@color/kaori_shade_far" />
        </aapt:attr>
    </path>

    <!-- Specular highlight: the one bright spot that sells the gloss. -->
    <path android:pathData="M36,45 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="45"
                android:centerY="45"
                android:gradientRadius="13"
                android:startColor="@color/kaori_specular"
                android:endColor="@color/kaori_specular_edge" />
        </aapt:attr>
    </path>

    <!-- Sphere outline. -->
    <path
        android:pathData="M33,56 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 z"
        android:fillColor="#00000000"
        android:strokeColor="@color/kaori_outline"
        android:strokeWidth="3" />

    <!-- Sparkles. -->
    <path
        android:pathData="M47,50 Q47,55.5 52.5,55.5 Q47,55.5 47,61 Q47,55.5 41.5,55.5 Q47,55.5 47,50 z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M41.5,56 Q41.5,59 44.5,59 Q41.5,59 41.5,62 Q41.5,59 38.5,59 Q41.5,59 41.5,56 z"
        android:fillColor="#FFFFFF" />

    <!-- The ring's near half — crosses in front of the sphere. -->
    <path
        android:pathData="M25.47,65.27 C29.79,78.59 86.86,60.04 82.53,46.73"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="70"
                android:endX="90"
                android:endY="40"
                android:startColor="@color/kaori_ring_lit"
                android:endColor="@color/kaori_ring_deep" />
        </aapt:attr>
    </path>

    <!-- Patcher ideation: a hex nut bolted through the ring at the planet's limb. Flat, on
         purpose — the fastener reads as a tool part, not as another lit body. -->
    <path
        android:pathData="M81,42.3 L77.75,47.93 L71.25,47.93 L68,42.3 L71.25,36.67 L77.75,36.67 Z M71.5,42.3 A3,3 0 1,1 77.5,42.3 A3,3 0 1,1 71.5,42.3 Z"
        android:fillType="evenOdd"
        android:fillColor="@color/kaori_ring"
        android:strokeColor="@color/kaori_outline"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round" />
</vector>
